<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mood Recipes</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-gradient-to-b from-indigo-50 to-indigo-100 min-h-screen">
  <div class="container mx-auto px-4 py-8">
    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-indigo-800 mb-2">Mood Recipes</h1>
      <p class="text-xl text-indigo-600">Find the perfect recipe for your current mood</p>
    </header>
    
    <main class="max-w-4xl mx-auto">
      <section id="mood-selection" class="bg-white rounded-lg shadow-lg p-6 mb-8">
        <h2 class="text-2xl font-semibold text-indigo-700 mb-4">How are you feeling today?</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <button class="mood-btn" data-mood="happy">
            <span class="text-2xl">😊</span>
            <span>Happy</span>
          </button>
          <button class="mood-btn" data-mood="sad">
            <span class="text-2xl">😔</span>
            <span>Sad</span>
          </button>
          <button class="mood-btn" data-mood="tired">
            <span class="text-2xl">😴</span>
            <span>Tired</span>
          </button>
          <button class="mood-btn" data-mood="anxious">
            <span class="text-2xl">😰</span>
            <span>Anxious</span>
          </button>
          <button class="mood-btn" data-mood="celebratory">
            <span class="text-2xl">🎉</span>
            <span>Celebratory</span>
          </button>
          <button class="mood-btn" data-mood="hot">
            <span class="text-2xl">🥵</span>
            <span>Hot</span>
          </button>
          <button class="mood-btn" data-mood="cold">
            <span class="text-2xl">🥶</span>
            <span>Cold</span>
          </button>
          <button class="mood-btn" data-mood="sick">
            <span class="text-2xl">🤒</span>
            <span>Sick</span>
          </button>
        </div>
      </section>
      
      <section id="recipe-display" class="bg-white rounded-lg shadow-lg p-6 hidden">
        <div class="text-center mb-4">
          <h2 id="recipe-name" class="text-2xl font-bold text-indigo-800 mb-2"></h2>
          <p class="text-indigo-600 italic">Perfect for your mood</p>
        </div>
        
        <div class="flex flex-col md:flex-row gap-6">
          <div class="md:w-1/2">
            <img id="recipe-image" src="" alt="Recipe" class="w-full h-64 object-cover rounded-lg">
          </div>
          
          <div class="md:w-1/2">
            <div class="mb-4">
              <h3 class="text-lg font-semibold text-indigo-700 mb-2">Ingredients</h3>
              <p id="recipe-ingredients" class="text-gray-700"></p>
            </div>
            
            <div>
              <h3 class="text-lg font-semibold text-indigo-700 mb-2">Instructions</h3>
              <p id="recipe-instructions" class="text-gray-700"></p>
            </div>
          </div>
        </div>
        
        <div class="mt-6 flex justify-center gap-4">
          <button id="new-recipe-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg transition">
            Show me another recipe
          </button>
          <button id="back-btn" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-lg transition">
            Change mood
          </button>
        </div>
      </section>
    </main>
  </div>
  
  <script src="/js/main.js"></script>
</body>
</html> 